#version 450

// Truncate shader: extracts magnitude from complex FFT output and truncates to half signal length

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) buffer InputBuffer {
	vec2 data[];  // Complex input (real, imag)
} inputBuf;

layout(binding = 1) buffer OutputBuffer {
	float data[];  // Real output (magnitude)
} outputBuf;

layout(push_constant) uniform PushConstants {
	uint fullSignalLength;  // Original signal length before truncation
	uint outputSignalLength;  // Truncated signal length (typically fullSignalLength / 2)
	uint samplesPerBuffer;  // Total samples per buffer
} params;

void main() {
	uint idx = gl_GlobalInvocationID.x;

	if (idx >= params.samplesPerBuffer) {
		return;
	}

	// Calculate which A-scan and sample within A-scan
	uint ascanIdx = idx / params.fullSignalLength;
	uint sampleIdx = idx % params.fullSignalLength;

	// Only process first half of samples (truncation)
	if (sampleIdx < params.outputSignalLength) {
		uint inputIdx = idx;
		uint outputIdx = ascanIdx * params.outputSignalLength + sampleIdx;

		// Compute raw magnitude: sqrt(real^2 + imag^2)
		// Note: Normalization is done in postprocess shader (different for log vs linear)
		vec2 complexValue = inputBuf.data[inputIdx];
		float magnitudeSquared = dot(complexValue, complexValue);
		float magnitude = sqrt(magnitudeSquared);

		outputBuf.data[outputIdx] = magnitude;
	}
}
