#version 450

// Dispersion Compensation shader: applies phase correction to complex data
// Multiplies input by complex phase factors

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) buffer InputBuffer {
	vec2 data[];  // Complex input data
} inputBuf;

layout(binding = 1) buffer PhaseComplexBuffer {
	vec2 data[];  // Complex phase factors (one per sample in A-scan)
} phaseComplexBuf;

layout(binding = 2) buffer OutputBuffer {
	vec2 data[];  // Complex output data (dispersion compensated)
} outputBuf;

layout(push_constant) uniform PushConstants {
	uint signalLength;  // Width (samples per A-scan)
	uint samplesPerBuffer;  // Total samples
} params;

void main() {
	uint index = gl_GlobalInvocationID.x;

	if (index >= params.samplesPerBuffer) {
		return;
	}

	// Calculate position within current A-scan
	uint phaseIndex = index % params.signalLength;

	// Because input.y is always zero (from k-linearization), we can simplify:
	// Complex multiplication: (a + bi) * (c + di) = (ac - bd) + (ad + bc)i
	// With b = 0: (a) * (c + di) = ac + adi
	float inX = inputBuf.data[index].x;
	vec2 phase = phaseComplexBuf.data[phaseIndex];

	outputBuf.data[index].x = inX * phase.x;
	outputBuf.data[index].y = inX * phase.y;
}
