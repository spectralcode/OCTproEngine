#version 450

// Windowing shader: applies window function to complex input data

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) buffer InputBuffer {
	vec2 data[];  // Complex input data
} inputBuf;

layout(binding = 1) buffer WindowBuffer {
	float data[];  // Window curve (same length as signal)
} windowBuf;

layout(binding = 2) buffer OutputBuffer {
	vec2 data[];  // Complex windowed output
} outputBuf;

layout(push_constant) uniform PushConstants {
	uint signalLength;  // Length of each A-scan
	uint samplesPerBuffer;  // Total samples per buffer
} params;

void main() {
	uint idx = gl_GlobalInvocationID.x;

	if (idx >= params.samplesPerBuffer) {
		return;
	}

	// Calculate which A-scan and sample within A-scan
	uint ascanIdx = idx / params.signalLength;
	uint sampleIdx = idx % params.signalLength;

	// Apply window function to both real and imaginary parts
	float windowValue = windowBuf.data[sampleIdx];
	outputBuf.data[idx].x = inputBuf.data[idx].x * windowValue;
	outputBuf.data[idx].y = inputBuf.data[idx].y * windowValue;
}
