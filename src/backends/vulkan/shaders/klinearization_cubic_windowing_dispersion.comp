#version 450

// Merged shader: K-Linearization (Cubic) + Windowing + Dispersion Compensation
// Combines three operations to eliminate intermediate memory transfers

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) buffer InputBuffer {
	vec2 data[];  // Complex input data
} inputBuf;

layout(binding = 1) buffer ResampleCurveBuffer {
	float data[];  // Resample curve (indices for interpolation)
} resampleCurveBuf;

layout(binding = 2) buffer WindowBuffer {
	float data[];  // Window curve
} windowBuf;

layout(binding = 3) buffer DispersionPhaseBuffer {
	vec2 data[];  // Complex phase for dispersion compensation
} dispersionPhaseBuf;

layout(binding = 4) buffer OutputBuffer {
	vec2 data[];  // Complex output data
} outputBuf;

layout(push_constant) uniform PushConstants {
	uint signalLength;  // Width (samples per A-scan)
	uint samplesPerBuffer;  // Total samples
} params;

// Cubic Hermite interpolation matching CUDA implementation
float cubicHermiteInterpolation(float y0, float y1, float y2, float y3, float pos) {
	float a = -y0 + 3.0f * (y1 - y2) + y3;
	float b = 2.0f * y0 - 5.0f * y1 + 4.0f * y2 - y3;
	float c = -y0 + y2;

	float pos2 = pos * pos;

	return 0.5f * pos * (a * pos2 + b * pos + c) + y1;
}

void main() {
	uint index = gl_GlobalInvocationID.x;

	if (index >= params.samplesPerBuffer) {
		return;
	}

	// Calculate position within current A-scan
	uint j = index % params.signalLength;
	uint offset = index - j;

	// Get interpolation position from resample curve
	float nx = resampleCurveBuf.data[j];
	int n1 = int(nx);
	int n0 = abs(n1 - 1);  // Using abs() to avoid negative n0
	int n2 = n1 + 1;
	int n3 = n2 + 1;

	// Sample 4 points for cubic interpolation
	float y0 = inputBuf.data[offset + n0].x;
	float y1 = inputBuf.data[offset + n1].x;
	float y2 = inputBuf.data[offset + n2].x;
	float y3 = inputBuf.data[offset + n3].x;

	// Interpolate using cubic Hermite
	float pos = nx - float(n1);

	// Apply k-linearization and windowing in one step
	float linearizedAndWindowedInX = cubicHermiteInterpolation(y0, y1, y2, y3, pos) * windowBuf.data[j];

	// Apply dispersion compensation (complex multiplication)
	vec2 phaseComplex = dispersionPhaseBuf.data[j];
	outputBuf.data[index].x = linearizedAndWindowedInX * phaseComplex.x;
	outputBuf.data[index].y = linearizedAndWindowedInX * phaseComplex.y;
}
